<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      No NSAppTransportSecurity, and there never will be: it exists only to relax the
      rules for outbound HTTP, and this app makes no requests at all (BUILD.md rule 8).
      The verifySourceBoundaries guard fails the build if it appears.
    -->
    <key>CFBundleDisplayName</key>
    <string>Trim Gallery</string>
    <key>CFBundleIdentifier</key>
    <string>app.trimgallery</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Trim Gallery shrinks your videos and photos on this device. Nothing is uploaded.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Trim Gallery saves the smaller version back to your library and keeps the original until you say otherwise.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>processing</string>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>app.trimgallery.night</string>
    </array>
</dict>
</plist>
