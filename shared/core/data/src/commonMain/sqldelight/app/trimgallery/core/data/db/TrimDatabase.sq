-- ARCHITECTURE.md § 4. One schema on every platform; only MediaItem.platformRef differs
-- (Android: SAF document URI, iOS: PHAsset localIdentifier).

CREATE TABLE MediaItem (
    id           INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    platformRef  TEXT    NOT NULL UNIQUE,
    name         TEXT    NOT NULL,
    kind         TEXT    NOT NULL,
    codec        TEXT,
    width        INTEGER NOT NULL DEFAULT 0,
    height       INTEGER NOT NULL DEFAULT 0,
    fps          REAL,
    bitrate      INTEGER,
    size         INTEGER NOT NULL,
    duration     INTEGER,
    takenAt      INTEGER,
    lat          REAL,
    lon          REAL,
    cameraModel  TEXT,
    hdr          INTEGER NOT NULL DEFAULT 0,
    motionPhoto  INTEGER NOT NULL DEFAULT 0,
    ultraHdr     INTEGER NOT NULL DEFAULT 0,
    livePhoto    INTEGER NOT NULL DEFAULT 0,
    raw          INTEGER NOT NULL DEFAULT 0,
    inCloudOnly  INTEGER NOT NULL DEFAULT 0,
    phash        INTEGER,
    sha256       TEXT,
    status       TEXT    NOT NULL DEFAULT 'NEW',
    skipReason   TEXT,
    mtime        INTEGER NOT NULL,
    -- Milestone 8. Additions to the ARCHITECTURE.md section 4 schema, noted in
    -- PROJECT.md: Favourites and the locked folder are both screens BUILD.md section 9
    -- requires, and both need to be readable without a join -- locked items are excluded
    -- from every other view, so every query filters on it.
    favourite    INTEGER NOT NULL DEFAULT 0,
    locked       INTEGER NOT NULL DEFAULT 0
);

-- Every gallery query excludes the locked folder, so this index carries the whole grid.
CREATE INDEX mediaItem_locked ON MediaItem(locked, takenAt DESC);
CREATE INDEX mediaItem_favourite ON MediaItem(favourite) WHERE favourite = 1;

-- The night pass walks candidates largest-saving-first (BUILD.md § 5).
CREATE INDEX mediaItem_status ON MediaItem(status);
CREATE INDEX mediaItem_size ON MediaItem(size DESC);
CREATE INDEX mediaItem_takenAt ON MediaItem(takenAt DESC);
-- Duplicate detection groups on these two (BUILD.md § 8).
CREATE INDEX mediaItem_phash ON MediaItem(phash);
CREATE INDEX mediaItem_sha256 ON MediaItem(sha256);

CREATE TABLE Job (
    id            INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    mediaId       INTEGER NOT NULL REFERENCES MediaItem(id) ON DELETE CASCADE,
    state         TEXT    NOT NULL DEFAULT 'QUEUED',
    startedAt     INTEGER,
    finishedAt    INTEGER,
    engine        TEXT,
    setting       TEXT,
    probes        INTEGER NOT NULL DEFAULT 0,
    xpsnr         REAL,
    vmaf          REAL,
    originalSize  INTEGER,
    newSize       INTEGER,
    energyEstimate REAL,
    thermalStart  REAL,
    thermalEnd    REAL,
    error         TEXT
);
CREATE INDEX job_mediaId ON Job(mediaId);

CREATE TABLE UndoEntry (
    id        INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    mediaId   INTEGER NOT NULL REFERENCES MediaItem(id) ON DELETE CASCADE,
    location  TEXT    NOT NULL,
    ref       TEXT    NOT NULL,
    expiresAt INTEGER,
    state     TEXT    NOT NULL DEFAULT 'ACTIVE'
);
CREATE INDEX undo_expiresAt ON UndoEntry(expiresAt);

CREATE TABLE Label (
    mediaId    INTEGER NOT NULL REFERENCES MediaItem(id) ON DELETE CASCADE,
    text       TEXT    NOT NULL,
    confidence REAL    NOT NULL
);
CREATE INDEX label_text ON Label(text);

CREATE TABLE Face (
    id      INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    mediaId INTEGER NOT NULL REFERENCES MediaItem(id) ON DELETE CASCADE,
    personId INTEGER REFERENCES Person(id) ON DELETE SET NULL,
    -- The embedding never leaves the device (BUILD.md § 7).
    vector  BLOB    NOT NULL,
    left    REAL    NOT NULL,
    top     REAL    NOT NULL,
    right   REAL    NOT NULL,
    bottom  REAL    NOT NULL
);
CREATE INDEX face_personId ON Face(personId);

CREATE TABLE Person (
    id          INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    displayName TEXT,
    coverMediaId INTEGER REFERENCES MediaItem(id) ON DELETE SET NULL
);

CREATE TABLE TextBlock (
    mediaId INTEGER NOT NULL REFERENCES MediaItem(id) ON DELETE CASCADE,
    text    TEXT    NOT NULL,
    left    REAL    NOT NULL,
    top     REAL    NOT NULL,
    right   REAL    NOT NULL,
    bottom  REAL    NOT NULL
);
CREATE INDEX textBlock_text ON TextBlock(text);

-- After ~20 matching files the search collapses to one probe (PROJECT.md § Speed).
CREATE TABLE Predictor (
    platform      TEXT    NOT NULL,
    device        TEXT    NOT NULL,
    cameraModel   TEXT    NOT NULL,
    codec         TEXT    NOT NULL,
    w             INTEGER NOT NULL,
    h             INTEGER NOT NULL,
    fps           INTEGER NOT NULL,
    bitrateBucket INTEGER NOT NULL,
    -- The winning bitrate in bits per second. INTEGER rather than the TEXT in
    -- ARCHITECTURE.md section 4: the search runs on bitrate and the table holds a running
    -- mean of it, which is arithmetic, not a label. Noted in PROJECT.md.
    setting       INTEGER NOT NULL,
    samples       INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (platform, device, cameraModel, codec, w, h, fps, bitrateBucket)
);

-- User-made albums. Auto-albums are rules over the index rather than rows here, so they
-- cannot drift out of step with what the indexer last saw (BUILD.md § 7).
CREATE TABLE Album (
    id           INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name         TEXT    NOT NULL,
    kind         TEXT    NOT NULL DEFAULT 'USER',
    coverMediaId INTEGER REFERENCES MediaItem(id) ON DELETE SET NULL
);

CREATE TABLE AlbumMember (
    albumId INTEGER NOT NULL REFERENCES Album(id) ON DELETE CASCADE,
    mediaId INTEGER NOT NULL REFERENCES MediaItem(id) ON DELETE CASCADE,
    PRIMARY KEY (albumId, mediaId)
);
CREATE INDEX albumMember_mediaId ON AlbumMember(mediaId);

CREATE TABLE FolderGrant (
    platformRef TEXT NOT NULL PRIMARY KEY,
    mode        TEXT NOT NULL
);

CREATE TABLE RunSession (
    id            INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    startedAt     INTEGER NOT NULL,
    finishedAt    INTEGER,
    filesDone     INTEGER NOT NULL DEFAULT 0,
    bytesFreed    INTEGER NOT NULL DEFAULT 0,
    minutesWorked INTEGER NOT NULL DEFAULT 0,
    wh            REAL    NOT NULL DEFAULT 0.0,
    seen          INTEGER NOT NULL DEFAULT 0
);

-- Queries -------------------------------------------------------------------

selectCandidatesBySaving:
SELECT * FROM MediaItem
WHERE status = 'CANDIDATE'
ORDER BY size DESC
LIMIT :limit;

selectByStatus:
SELECT * FROM MediaItem WHERE status = ?;

-- The grid. Locked items never appear anywhere but the locked folder.
selectGallery:
SELECT * FROM MediaItem WHERE locked = 0 ORDER BY takenAt DESC;

selectFavourites:
SELECT * FROM MediaItem WHERE favourite = 1 AND locked = 0 ORDER BY takenAt DESC;

selectLocked:
SELECT * FROM MediaItem WHERE locked = 1 ORDER BY takenAt DESC;

selectAlbumMedia:
SELECT MediaItem.* FROM MediaItem
JOIN AlbumMember ON AlbumMember.mediaId = MediaItem.id
WHERE AlbumMember.albumId = ? AND MediaItem.locked = 0
ORDER BY MediaItem.takenAt DESC;

setFavourite:
UPDATE MediaItem SET favourite = ? WHERE id = ?;

setLocked:
UPDATE MediaItem SET locked = ? WHERE id = ?;

selectExpiredUndo:
SELECT * FROM UndoEntry WHERE state = 'ACTIVE' AND expiresAt IS NOT NULL AND expiresAt <= ?;

-- Both values come from Predictor.learn, which folds the new result into a running mean.
-- Doing it here instead would put the arithmetic somewhere it cannot be unit tested, and
-- last-write-wins would let one unusually busy clip replace what twenty files agreed on.
upsertPredictor:
INSERT OR REPLACE INTO Predictor(platform, device, cameraModel, codec, w, h, fps, bitrateBucket, setting, samples)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectPredictor:
SELECT * FROM Predictor
WHERE platform = ? AND device = ? AND cameraModel = ? AND codec = ?
  AND w = ? AND h = ? AND fps = ? AND bitrateBucket = ?;

lastRunSession:
SELECT * FROM RunSession ORDER BY startedAt DESC LIMIT 1;
