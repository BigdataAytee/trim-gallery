# Generated by CMake. meson needs its own description of the cross toolchain, so this is
# filled in from the compiler CMake already resolved rather than hand-maintained — the
# two drifting apart is how a library ends up built for the wrong ABI.
[binaries]
c = '@CMAKE_C_COMPILER@'
cpp = '@CMAKE_CXX_COMPILER@'
ar = '@CMAKE_AR@'
strip = '@CMAKE_STRIP@'
pkg-config = 'pkg-config'

[host_machine]
system = '@TRIM_MESON_SYSTEM@'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'

[built-in options]
# The two lists below open with the target and sysroot CMake resolved, substituted in by
# configure_file. They are on the link line as well as the compile line because meson's
# sanity check links an executable, and a driver told to compile for arm64 but not to link
# for it reaches for the host's C runtime.
c_args = [@TRIM_MESON_TOOLCHAIN_ARGS@'-march=armv8-a+simd', '-O3']
c_link_args = [@TRIM_MESON_LINK_ARGS@]
