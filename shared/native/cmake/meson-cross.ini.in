# Generated by CMake. meson needs its own description of the cross toolchain, so this is
# filled in from the compiler CMake already resolved rather than hand-maintained — the
# two drifting apart is how a library ends up built for the wrong ABI.
[binaries]
c = '@CMAKE_C_COMPILER@'
cpp = '@CMAKE_CXX_COMPILER@'
ar = '@CMAKE_AR@'
strip = '@CMAKE_STRIP@'
pkg-config = 'pkg-config'

[host_machine]
system = '@TRIM_MESON_SYSTEM@'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'

[built-in options]
# The two lists below open with the target and sysroot CMake resolved, substituted in by
# configure_file. They are on the link line as well as the compile line because meson's
# sanity check links an executable, and a driver told to compile for arm64 but not to link
# for it reaches for the host's C runtime.
c_args = [@TRIM_MESON_TOOLCHAIN_ARGS@'-march=armv8-a+simd', '-O3']
c_link_args = [@TRIM_MESON_LINK_ARGS@]
# And the same again for C++, which is not optional here even though libvmaf is a C
# library: it bundles libsvm, and `svm.cpp` is the one C++ file in the tree. meson applies
# `c_args` to C only, so with these two lines missing that single object was built by the
# NDK's clang++ driver with no target and no sysroot — that is, for the host. It archived
# into libvmaf.a without complaint and surfaced two minutes later, at the very end of the
# arm64 link, as
#     ld.lld: error: vmaf-build/src/libvmaf.a(svm.cpp.o) is incompatible with aarch64linux
cpp_args = [@TRIM_MESON_TOOLCHAIN_ARGS@'-march=armv8-a+simd', '-O3']
cpp_link_args = [@TRIM_MESON_LINK_ARGS@]
