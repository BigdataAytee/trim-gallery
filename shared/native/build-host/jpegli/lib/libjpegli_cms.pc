prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libjpegli_cms
Description: CMS support library for libjpegli
Version: 0.12.0
Requires.private: 
Libs: -L${libdir} -ljpegli_cms 
Libs.private: -lm -lstdc++
Cflags: -I${includedir}
Cflags.private: -DJPEGLI_CMS_STATIC_DEFINE
