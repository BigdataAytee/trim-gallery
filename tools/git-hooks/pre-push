#!/usr/bin/env bash
#
# Refuses a push whose diff reaches outside the branch's declared scope.
#
# Why: during the AGP 9 work an uncommitted version bump was carried onto an
# unrelated ABI branch by a `git checkout`, committed there, and pushed. It was
# only caught by reading the PR diff afterwards. The branch had a clear scope —
# three files about an ABI property — and `gradle/libs.versions.toml` was not in
# it. A machine can see that; a person re-reading their own diff often cannot.
#
# A branch declares its scope in .github/pr-scope/<branch>.txt: one glob per
# line, `#` comments ignored. No scope file means no restriction, so this cannot
# block work that has not opted in.
#
# Globs follow the conventional meaning rather than shell `case` semantics:
# `*` matches within one path segment, `**` crosses slashes, `?` matches one
# non-slash character. With plain `case`, `*` matches `/` too, so `shared/*`
# would silently authorise `shared/core/pipeline/**` — the boundary this project
# guards hardest. A pattern must reach a file: `androidApp/**`, not `androidApp`.
#
# Always allowed, without being declared: the branch's own scope file, PROJECT.md
# and CHANGELOG.md. Those three are touched by nearly every branch here, and
# requiring them in every scope file would turn the mechanism into boilerplate
# people stop reading.
#
# Portability is load-bearing, not incidental: this project has an iOS app and a
# macOS CI job, so it must work on macOS's bash 3.2 and BSD userland. Three
# things below exist for that reason and should not be "simplified":
#   - a `read -t` builtin loop rather than `timeout cat` (no timeout(1) on macOS,
#     where its absence would silently fall back to HEAD and disable the fix),
#   - `[[:space:]]` rather than `\s` (BSD grep reads `\s` as a literal `s`),
#   - `${violations[*]:-}` rather than `${#violations[@]}` (expanding an empty
#     array under `set -u` is an error before bash 4.4).
#
# Bypass with --no-verify if you are sure. Then widen the scope file, because the
# next push will ask again.

set -uo pipefail

# Conventional glob matching: ** crosses slashes, * and ? do not.
matches_glob() {
    local file=$1 pattern=$2 rx='' i c
    for (( i=0; i<${#pattern}; i++ )); do
        c=${pattern:i:1}
        case "$c" in
            '*')
                if [ "${pattern:i:2}" = '**' ]; then rx="$rx.*"; i=$((i+1))
                else rx="$rx[^/]*"; fi ;;
            '?') rx="$rx[^/]" ;;
            '.'|'+'|'('|')'|'['|']'|'{'|'}'|'^'|'$'|'|'|'\') rx="$rx\\$c" ;;
            *) rx="$rx$c" ;;
        esac
    done
    [[ $file =~ ^$rx$ ]]
}

status=0

# Git hands a pre-push hook the refs actually being pushed, one per line:
#   <local ref> <local sha> <remote ref> <remote sha>
# Checking HEAD instead would check the wrong branch for `git push origin
# other-branch`, a multi-ref push, or `git push --all`.
#
# `read -t` rather than `timeout cat`: a bash builtin, present everywhere. Git
# writes the lines and closes stdin, so this returns at once in real use; on a
# terminal or a pipe that never reaches EOF it gives up after the timeout and
# falls back to HEAD, which is what a manual dry run wants.
refs=''
while IFS= read -r -t 2 line; do
    refs="$refs$line"$'\n'
done
if [ -z "${refs//[$'\n' ]/}" ]; then
    refs="$(git symbolic-ref -q HEAD || echo refs/heads/HEAD) $(git rev-parse HEAD) - -"
fi

while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    case "$local_sha" in ''|0000000000000000000000000000000000000000) continue ;; esac  # deletion

    branch=${local_ref#refs/heads/}
    scope_path=".github/pr-scope/$branch.txt"

    # Read the scope file *out of the commit being pushed*, not out of the
    # working tree. The tree belongs to whichever branch is checked out here,
    # which under the worktree-per-branch workflow is usually a different branch
    # entirely — so the lookup would miss and the push would go unexamined. It
    # also means an uncommitted `rm` of the scope file cannot disable the check
    # for a commit that still contains it.
    scope_text=$(git show "$local_sha:$scope_path" 2>/dev/null) || continue

    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || {
        echo "pre-push: no merge-base with origin/main for $branch; not checking scope" >&2
        continue
    }

    changed=$(git diff --name-only "$base".."$local_sha")
    [ -n "$changed" ] || continue

    patterns=$(printf '%s\n' "$scope_text" | grep -v '^[[:space:]]*#' | grep -v '^[[:space:]]*$')
    if [ -z "$patterns" ]; then
        echo "pre-push: $scope_path declares no patterns." >&2
        echo "          A scope file that permits nothing is probably a mistake:" >&2
        echo "          delete it to opt out, or list what this branch may touch." >&2
        status=1
        continue
    fi

    violations=()
    while IFS= read -r file; do
        case "$file" in
            "$scope_path"|PROJECT.md|CHANGELOG.md) continue ;;
        esac
        ok=0
        while IFS= read -r pattern; do
            matches_glob "$file" "$pattern" && { ok=1; break; }
        done <<< "$patterns"
        [ "$ok" = "1" ] || violations+=("$file")
    done <<< "$changed"

    # `${violations[*]:-}` and not `${#violations[@]}`: expanding an empty array
    # under `set -u` is an error on bash before 4.4, which is what macOS ships.
    [ -z "${violations[*]:-}" ] && continue

    {
        echo
        echo "pre-push: this branch's diff reaches outside its declared scope."
        echo
        echo "  branch : $branch"
        echo "  scope  : $scope_path (read from the commit being pushed)"
        echo
        echo "  declared:"
        while IFS= read -r pattern; do echo "    $pattern"; done <<< "$patterns"
        echo
        echo "  outside it:"
        for v in "${violations[@]}"; do echo "    $v"; done
        echo
        echo "Either these files do not belong on this branch — the usual cause is an"
        echo "edit carried across by a checkout — or the scope is too narrow. Fix the"
        echo "branch, or widen $scope_path and say why in the commit."
        echo
        echo "If the list looks like files you never touched, your origin/main may be"
        echo "stale: the diff is taken from its merge-base. \`git fetch origin main\`."
        echo
    } >&2
    status=1
done <<< "$refs"

exit "$status"
